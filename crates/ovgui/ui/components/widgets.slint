// Small shared widgets: Card, Toggle, SettingRow, Segmented, StatusDot,
// NavItem, Modal, Toast, Divider.

import { Theme } from "../theme.slint";
import { Icon, IconSize } from "icon.slint";

export component Divider inherits Rectangle {
    height: 1px;
    vertical-stretch: 0;
    background: Theme.border;
}

// A white panel with a soft border; children go in a padded VerticalLayout.
export component Card inherits Rectangle {
    in property <length> pad: Theme.spacing-xl;
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: Theme.dark ? 0px : 12px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #0F172A0D;
    VerticalLayout {
        padding: root.pad;
        spacing: Theme.spacing-md;
        alignment: start;
        @children
    }
}

// Section heading inside a card: icon + title (+ optional subtitle).
export component CardHeader inherits HorizontalLayout {
    in property <string> icon-name;
    in property <string> title;
    in property <string> subtitle: "";
    spacing: Theme.spacing-md;
    alignment: start;
    vertical-stretch: 0;
    Rectangle {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: Theme.primary-soft;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon-name;
            size: IconSize.MD;
            icon-color: Theme.primary;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Theme.font-lg;
            font-weight: Theme.font-weight-semibold;
        }
        if subtitle != "": Text {
            text: root.subtitle;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
}

// iOS-style switch. Hit area grows past the 40x22 track.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: self.height / 2;
    background: checked ? (enabled ? Theme.primary : Theme.border-strong) : Theme.border-strong;
    opacity: enabled ? 1.0 : 0.5;
    animate background { duration: Theme.duration-fast; }
    Rectangle {
        width: 18px;
        height: 18px;
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: 9px;
        background: white;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000040;
        animate x { duration: Theme.duration-fast; easing: ease-out; }
    }
    TouchArea {
        x: -6px;
        y: -6px;
        width: parent.width + 12px;
        height: parent.height + 12px;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Settings row: title + description on the left, a control on the right.
export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description: "";
    min-height: 56px;
    vertical-stretch: 0;
    HorizontalLayout {
        padding-top: Theme.spacing-md;
        padding-bottom: Theme.spacing-md;
        spacing: Theme.spacing-lg;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: Theme.font-md;
                font-weight: Theme.font-weight-medium;
            }
            if description != "": Text {
                text: root.description;
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            @children
        }
    }
}

// Segmented control (Auto / 30 / 60).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed-to(int);
    height: 32px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for opt[i] in root.options: Rectangle {
            width: max(64px, seg-label.preferred-width + 24px);
            border-radius: 4px;
            background: i == root.selected ? Theme.surface : (ta.has-hover ? Theme.surface-hover : transparent);
            drop-shadow-blur: i == root.selected ? 3px : 0px;
            drop-shadow-color: #0000001F;
            seg-label := Text {
                text: opt;
                color: i == root.selected ? Theme.primary : Theme.text-secondary;
                font-size: Theme.font-sm;
                font-weight: i == root.selected ? Theme.font-weight-semibold : Theme.font-weight-regular;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.selected != i {
                        root.selected = i;
                        root.changed-to(i);
                    }
                }
            }
        }
    }
}

// Status indicator dot with a soft halo.
export component StatusDot inherits Rectangle {
    in property <color> dot-color;
    width: 14px;
    height: 14px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 7px;
    background: dot-color.with-alpha(0.22);
    Rectangle {
        width: 8px;
        height: 8px;
        x: 3px;
        y: 3px;
        border-radius: 4px;
        background: root.dot-color;
    }
}

// Sidebar navigation row: arrow cursor (hover bg is the affordance).
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    in property <bool> active;
    callback clicked();
    height: 40px;
    vertical-stretch: 0;
    border-radius: Theme.radius-md;
    background: active ? Theme.primary-soft : (ta.has-hover ? Theme.surface-hover : transparent);
    animate background { duration: Theme.duration-fast; }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.active ? 20px : 0px;
        border-radius: 1.5px;
        background: Theme.primary;
    }
    HorizontalLayout {
        padding-left: Theme.spacing-md;
        spacing: Theme.spacing-md;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon-name;
                size: IconSize.MD;
                icon-color: root.active ? Theme.primary : Theme.text-secondary;
            }
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            color: root.active ? Theme.primary : Theme.text-primary;
            font-size: Theme.font-md;
            font-weight: root.active ? Theme.font-weight-semibold : Theme.font-weight-regular;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Modal shell: scrim that swallows clicks AND scroll, centered dialog card.
// Always in the tree; `shown` collapses it (never `if`).
export component Modal inherits Rectangle {
    in property <bool> shown;
    in property <string> title;
    in property <length> dialog-width: 420px;
    callback dismissed();
    visible: shown;
    background: Theme.scrim;
    TouchArea {
        clicked => { root.dismissed(); }
        scroll-event(e) => { return accept; }
    }
    Rectangle {
        width: root.dialog-width;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000040;
        // Swallow clicks on the dialog body so they don't dismiss.
        TouchArea { }
        content := VerticalLayout {
            padding: Theme.spacing-xl;
            spacing: Theme.spacing-lg;
            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: Theme.font-xl;
                font-weight: Theme.font-weight-semibold;
            }
            @children
        }
    }
}

// Toast pill at the bottom; render LAST so it is topmost.
export component Toast inherits Rectangle {
    in property <string> message;
    in property <bool> shown;
    property <bool> on: shown && message != "";
    width: label.preferred-width + 40px;
    height: 40px;
    border-radius: self.height / 2;
    background: Theme.dark ? #ECEFF4 : #1F2430;
    opacity: on ? 1.0 : 0.0;
    animate opacity { duration: 160ms; }
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Icon { name: "check"; size: IconSize.SM; icon-color: Theme.dark ? #16A34A : #34C77B; }
        }
        label := Text {
            text: root.message;
            color: Theme.dark ? #161B26 : #F3F5F8;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
    }
}
