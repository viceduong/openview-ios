// ClickAway — clicking empty space unfocuses any text field.
//
// Place it as the FIRST child of the window (full size): elements declared
// AFTER it draw on top and still receive their own clicks; only clicks that
// hit nothing interactive fall through to here, which hands focus to a sink
// that accepts no keystrokes. Call `clear()` to unfocus programmatically
// (e.g. on page switch, so typing can't reach a now-hidden field).

export component ClickAway inherits Rectangle {
    width: 100%;
    height: 100%;

    public function clear() {
        sink.focus();
    }

    sink := FocusScope { width: 0px; height: 0px; }

    TouchArea {
        clicked => { sink.focus(); }
    }
}
