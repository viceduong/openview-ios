# Rust
/target/
**/*.rs.bk

# Build outputs / packaging
/dist/
ios/OpenView/dist/
*.a
*.lib
*.xcframework
*.ipa
*.ovrec

# Xcode (the project is generated by XcodeGen from project.yml)
*.xcodeproj/
*.xcworkspace/
DerivedData/
xcuserdata/
build/
# Per-developer iOS build overrides (signing team, bundle id prefix, relay)
ios/OpenView/Config/Local.xcconfig

# Python bytecode (scripts/)
__pycache__/
*.pyc

# Logs
*.log

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Always track documentation (overrides a global *.md ignore, if any)
!*.md
